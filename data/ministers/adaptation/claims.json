  "entries": [
    {
      "id": "901abbf78a84451d9bfbb1ad2ab3b435",
      "text": "Great companies adapt and endure through technological change.",
      "source": {
        "book": "Collins-2001-Good-to-Great-Why-Some-Companies-Make-the-Leap...and-Others-Dont_",
        "chapter": 81
      },
      "weight": 1.0
    },
    {
      "id": "4148fbc92038458cb809827f6804a86b",
      "text": "Technological sophistication is not an end in itself, but a means to an end.",
      "source": {
        "book": "Collins-2001-Good-to-Great-Why-Some-Companies-Make-the-Leap...and-Others-Dont_",
        "chapter": 81
      },
      "weight": 1.0
    },
    {
      "id": "4e434645f5b147dc8ddfc36d7bede800",
      "text": "Pioneering the application of carefully selected technologies is key to success.",
      "source": {
        "book": "Collins-2001-Good-to-Great-Why-Some-Companies-Make-the-Leap...and-Others-Dont_",
        "chapter": 81
      },
      "weight": 1.0
    },
    {
      "id": "cbc1ffbc7a7b4231b53c2c7237088fa8",
      "text": "Investing in technology should be tied to a clear business strategy.",
      "source": {
        "book": "Collins-2001-Good-to-Great-Why-Some-Companies-Make-the-Leap...and-Others-Dont_",
        "chapter": 81
      },
      "weight": 1.0
    },
    {
      "id": "729ca6b2959e4d10a344dcafe67f8d3d",
      "text": "Manufacturing technology can be a key driver of innovation and success.",
      "source": {
        "book": "Collins-2001-Good-to-Great-Why-Some-Companies-Make-the-Leap...and-Others-Dont_",
        "chapter": 81
      },
      "weight": 1.0
    }
